[Unit]
Description=Run EduPulse large-v3 upgrade daily after school (16:05)
Documentation=file:%h/Documents/GrokBuild/EduPulse/scripts/systemd/README-heavy-upgrade.md

[Timer]
# After typical school day; RandomizedDelay spreads load if multiple machines
OnCalendar=*-*-* 16:05:00
# If the laptop was off/asleep at 16:05, run after next wake/boot (still AC-gated)
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
